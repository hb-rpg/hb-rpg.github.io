{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: Nemo Esuriat Full Debug",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/NemoEsuriat.csproj"
        },
        {
            "name": "Debug one ts file",
            "type": "node",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "PDF Harness server",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/Tools/serve-harness.mjs",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"],
            // Compile the harness TypeScript into wwwroot/Scripts before serving.
            "preLaunchTask": "tsc build",
            // Auto-open the harness page once the server logs its URL.
            "serverReadyAction": {
                "pattern": "http://localhost:([0-9]+)",
                "uriFormat": "http://localhost:%s/",
                "action": "openExternally"
            }
        },

    ]
}