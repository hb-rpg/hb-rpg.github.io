# Deployment settings for Tools/Windows/Publish-To-Server.ps1
# Copy this file to .env and fill in your own values. .env is gitignored.
#
# Format notes:
#   - "#" only starts a comment at the beginning of a line. A trailing comment
#     such as "DEPLOY_HOST=1.2.3.4 # prod" becomes part of the value and will
#     be rejected.
#   - A leading "export " is accepted and ignored.
#   - Quote characters are rejected anywhere in a value.
#   - Every value is validated before the script runs anything destructive; an
#     unrecognised key is warned about rather than silently ignored.

# SSH login for the target server.
# DEPLOY_USER  must match ^[A-Za-z0-9._-]+$
# DEPLOY_HOST  must match ^[A-Za-z0-9._:\[\]-]+$
DEPLOY_USER=your-username
DEPLOY_HOST=your.server.ip.or.hostname

# Parent directory on the server that the bundle is installed into.
# Must be an absolute Unix path. The resulting target
# (DEPLOY_REMOTE_PARENT/DEPLOY_DIR_NAME) must be at least two levels deep and
# must not be a system directory -- rsync --delete runs against it.
DEPLOY_REMOTE_PARENT=/var/www

# Name of the bundle directory, used both locally and on the server.
# A single directory name: no slashes, no "." or "..". The local bundle is
# created at <repo root>/<DEPLOY_DIR_NAME> and deleted after each deploy.
DEPLOY_DIR_NAME=Heartbreaker

# systemd unit for the app, and the web server to restart after deploying.
# DEPLOY_SERVICE_NAME defaults to DEPLOY_DIR_NAME if unset.
DEPLOY_SERVICE_NAME=Heartbreaker
DEPLOY_WEB_SERVICE=apache2

# user:group that should own the deployed files.
DEPLOY_OWNER=www-data:www-data
